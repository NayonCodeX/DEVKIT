# DEVKIT environment variables example.
# Copy this file to `.env.local` and fill in only the providers you use.
# NEVER commit the real .env.local file. NEVER put real keys in any
# frontend file (HTML, CSS, JS, JSON), in localStorage, in IndexedDB,
# in the service worker cache, or in any file pushed to a public repo.

# ===== AI providers (the backend holds the keys, never the browser) =====

# OpenRouter (https://openrouter.ai/keys) — RECOMMENDED, supports free models.
# When this is set, an OpenRouter provider is auto-registered on the backend
# with the model "nvidia/nemotron-3.5-lightning:free" by default. You can
# change the model later in Settings → AI Providers, or pick any of these
# free models:
#   nvidia/nemotron-3.5-lightning:free
#   cohere/north-mini-code:free
#   google/gemma-4-26b-a4b-it:free
#   google/gemma-4-31b-it:free
#   nvidia/nemotron-3-ultra-550b-a55b:free
OPENROUTER_API_KEY=

# OpenAI (https://platform.openai.com/api-keys)
OPENAI_API_KEY=

# Google Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Anthropic (https://console.anthropic.com/settings/keys)
ANTHROPIC_API_KEY=

# Public URL of your deployed app (used by OpenRouter's HTTP-Referer header
# for app attribution, and as the GitHub OAuth callback base URL).
APP_PUBLIC_URL=https://your-app.example.com

# ===== GitHub OAuth (optional — you can also use a Personal Access Token) =====
# There are TWO ways to connect GitHub from the app:
#
# 1. Personal Access Token (PAT) — works in any environment, no public URL needed.
#    Users paste a token directly in the GitHub section of the app. The token is
#    sent to the backend once, validated, and stored in an HTTP-only cookie.
#    No env var needed for this — just create a token at
#    https://github.com/settings/tokens/new with scopes "repo" and "read:user".
#
# 2. OAuth App — best for multi-user deployments.
#    Requires the three env vars below + a public callback URL.

GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
# Public callback URL, e.g. https://your-app.example.com/api/github/oauth/callback
GITHUB_OAUTH_REDIRECT_URI=

# ===== Misc =====
NODE_ENV=development
# NEXT_PUBLIC_* variables are exposed to the browser. Do NOT put secrets here.

