# DEVKIT environment variables example.
# Copy this file to `.env.local` and fill in only the providers you use.
# NEVER commit the real .env.local file. NEVER put real keys in any
# frontend file (HTML, CSS, JS, JSON), in localStorage, in IndexedDB,
# in the service worker cache, or in any file pushed to a public repo.

# ===== AI providers (the backend holds the keys, never the browser) =====

# Google Gemini (generativelanguage.googleapis.com)
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# OpenAI (api.openai.com)
# Get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Anthropic (api.anthropic.com)
# Get a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# ===== GitHub OAuth (https://github.com/settings/developers) =====
# Create an OAuth App. The callback URL must be exactly:
#   <your-deployment-origin>/api/github/oauth/callback

GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
# Public callback URL, e.g. https://your-app.example.com/api/github/oauth/callback
GITHUB_OAUTH_REDIRECT_URI=

# ===== Misc =====
NODE_ENV=development
# NEXT_PUBLIC_* variables are exposed to the browser. Do NOT put secrets here.
